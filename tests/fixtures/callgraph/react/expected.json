  "notes": {
    "jsx-component": "A JSX element whose tag is a capitalised name or a member expression renders that component: a call of it, resolved like `Header()`.",
    "barrel": "Imported through components/index.ts, which re-exports Button.tsx: the barrel's prefix reaches the defining file (package confidence).",
    "namespace-member": "`<Ui.Icon />` on `import * as Ui from './components'` is the namespace's member, reached through the barrel's `export *`.",
    "default-export": "A default-exported function component rendered under its import name.",
    "same-file": "A component defined in the same file.",
    "jsx-file": "A .jsx file (the JavaScript grammar) renders components the same way.",
    "prop-component": "`<Slot />` renders a parameter: no repository function.",
    "class-component": "`<Modal />` renders a class component: a call of the `render` Modal owns (a default import: the default-exported class's), never of a Function named Modal.",
    "external-component": "`<Link />` comes from react-router-dom, outside the repository.",
    "scope": "Intrinsic tags (`<main>`, `<li>`, `<svg>`, `<path>`, `<input>`) are no calls. An element inside an anonymous arrow (the `rows.map` callback, Root's `Slot` arrow) renders from the enclosing named function; calls there are still attributed to no one.",
    "imports-format": "In-repo ES imports and `export ... from` re-exports, file to file; external packages give none.",
    "hook": "A hook is a plain function call.",
    "fragment": "Components inside a fragment (`<>...</>`, which has no tag) render as anywhere else.",
    "element-prop": "`element={<HomePage />}` renders HomePage from AppRoutes: a JSX attribute's expression is no nested scope.",
    "callback-render": "`rows.map((row) => <ListRow ... />)` renders ListRow from App, the named function holding the callback.",
    "render-prop": "`<App Slot={() => <Toast />} />`: an inline render prop's element renders from Root.",
    "memo": "`const Badge = memo(function Badge(...) {...})` is the component Badge.",
    "forward-ref": "`const Field = forwardRef((props, ref) => ...)` is the component Field, its arrow's elements its own.",
    "styled": "`const Label = styled.span`...`` is a component with no body: rendering it is a call of it."
  }
